# no secrets here — copy to .env for local dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_mvp
PORT=3001
# Gemini Vision key for receipt extraction (backend only, never commit the real key)
GEMINI_API_KEY=
# Override only if needed
GEMINI_MODEL=gemini-2.0-flash
# Explicit frontend origin(s) for credentialed CORS (never "*" with cookies).
# Comma-separated allowlist. Add your LAN origin for device testing, e.g.:
# WEB_ORIGIN=http://localhost:7364,http://127.0.0.1:7364,http://192.168.1.59:7364
WEB_ORIGIN=http://localhost:7364,http://127.0.0.1:7364
# The only email eligible for SUPERADMIN on first register (fail-closed:
# unset or empty means every register becomes CLIENT). Never commit real data.
SUPERADMIN_EMAIL=
